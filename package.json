{
  "name": "blood-cell-morphology-ui",
  "version": "2.0.0",
  "private": true,
  "description": "血球形態分類介面原型（優化版）：TypeScript + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "lint": "tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "state-space": "tsx tools/state-space.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "material-symbols": "^0.40.2"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
